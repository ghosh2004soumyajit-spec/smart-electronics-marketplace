# ---- VoltHaus frontend environment ----
# Copy to .env.local and adjust. No secrets belong in the frontend build.

# Base URL of the Express API (used when VITE_USE_MOCK=false).
# In dev, Vite proxies /api to this target (see vite.config.js).
VITE_API_URL=/api
VITE_PROXY_TARGET=http://localhost:5000

# Set to "false" once the real Node/Express backend is running.
# While "true", src/services/api.js answers from the local mock layer
# (src/services/mockDb.js) seeded to match database/schema.sql.
VITE_USE_MOCK=true

# Cloudinary: leave empty while using generated line-art product visuals.
# When real photos exist, set this and products' image paths resolve through it.
VITE_CLOUDINARY_URL=
